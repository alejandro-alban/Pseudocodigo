Algoritmo Punto_Medio_Distancia

    //Declaraciones
    Definir x1, y1, x2, y2 Como Real
    Definir distancia, puntoMedioX, puntoMedioY Como Real
    //Cuerpo
    Escribir "Ingrese la coordenada x del primer punto:"
      Leer x1
    Escribir "Ingrese la coordenada y del primer punto:"
      Leer y1
    Escribir "Ingrese la coordenada x del segundo punto:"
      Leer x2
    Escribir "Ingrese la coordenada y del segundo punto:"
      Leer y2

    distancia <- RC((x2 - x1)^2 + (y2 - y1)^2)
    puntoMedioX <- (x1 + x2) / 2
    puntoMedioY <- (y1 + y2) / 2

    Escribir "La distancia entre los puntos es: ", distancia
    Escribir "El punto medio es: (", puntoMedioX, ", ", puntoMedioY, ")"
FinAlgoritmo
