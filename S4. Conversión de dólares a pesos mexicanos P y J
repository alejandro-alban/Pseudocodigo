Java
import java.util.Scanner;

public class S4 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        System.out.print("Ingrese la cantidad en dólares: ");
        double dolares = sc.nextDouble();

        System.out.print("Ingrese el tipo de cambio: ");
        double cambio = sc.nextDouble();

        double pesos = dolares * cambio;

        System.out.println("Cantidad en pesos mexicanos: " + pesos);
    }
}
