Algoritmo Validar_Fecha
  //Declaraciones
  Definir dia, mes, anio, diasMes Como Entero
  Definir valida Como Logico
  //Cuerpo
  Escribir "Ingrese el dia:"
    Leer dia
  Escribir "Ingrese el mes:"
    Leer mes
  Escribir "Ingrese el anio:"
    Leer anio

    valida <- Falso
    diasMes <- 0

  Si mes >= 1 Y mes <= 12 Y anio > 0 Entonces

      Segun mes Hacer
          1, 3, 5, 7, 8, 10, 12:
              diasMes <- 31
          4, 6, 9, 11:
              diasMes <- 30
          2:  
              Si (anio MOD 400 = 0) O
                 (anio MOD 4 = 0 Y anio MOD 100 <> 0) Entonces
                  diasMes <- 29
              SiNo
                  diasMes <- 28
              FinSi
      FinSegun

      Si dia >= 1 Y dia <= diasMes Entonces
          valida <- Verdadero
      FinSi

  FinSi

  Si valida Entonces
     Escribir "La fecha es valida"
  SiNo
      Escribir "La fecha no es valida"
  FinSi
FinAlgoritmo
