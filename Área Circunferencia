Algoritmo CircunferenciaYArea ()
Inicio
    Definir radio, longitud, area Como Real
    Escribir "Ingrese el radio de la circunferencia:"
    longitud <- 2 * PI * radio
    area <- PI * (radio ^2)
    Escribir "La longitud de la circunferencia es: ", longitud
    Escribir "El área de la circunferencia es: ", area
Fin
