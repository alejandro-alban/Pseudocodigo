Java
import java.util.Scanner;

public class R1 {
    public static void main(String[] args) {
        Scanner sc = new Scanner(System.in);

        int suma = 0;

        System.out.print("Ingrese un número (0 para terminar): ");
        int numero = sc.nextInt();

        while (numero != 0) {
            suma = suma + numero;

            System.out.print("Ingrese un número (0 para terminar): ");
            numero = sc.nextInt();
        }

        System.out.println("Suma total: " + suma);
    }
}
